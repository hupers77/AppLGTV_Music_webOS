{
	"name": "tv-music-player",
	"version": "1.0.0",
	"description": "webOS TV music player (Enact) - black screen, track title and progress bar only",
	"main": "src/index.js",
	"scripts": {
		"serve": "enact serve",
		"pack": "enact pack",
		"pack-p": "enact pack --production",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"lint": "enact lint --strict .",
		"test": "enact test",
		"package": "npm run pack-p && ares-package dist",
		"install-tv": "ares-install -d tv com.example.tvmusic_1.0.0_all.ipk",
		"launch-tv": "ares-launch -d tv com.example.tvmusic"
	},
	"license": "UNLICENSED",
	"private": true,
	"enact": {
		"theme": "sandstone"
	},
	"dependencies": {
		"@enact/core": "^4.9.0",
		"@enact/i18n": "^4.9.0",
		"@enact/sandstone": "^2.9.0",
		"@enact/spotlight": "^4.9.0",
		"@enact/ui": "^4.9.0",
		"classnames": "^2.3.2",
		"ilib": "^14.19.0",
		"prop-types": "^15.8.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@enact/cli": "^6.1.0",
		"@webos-tools/cli": "^3.0.0"
	}
}
